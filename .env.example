# Public — safe to expose to the browser (Supabase anon key is designed for this;
# access control is enforced by Row Level Security, not by keeping this secret).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API keys → publishable key (sb_publishable_…).
# The legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_, never import in a Client Component,
# never send to the browser. Bypasses Row Level Security — used only in trusted
# server-side code (Route Handlers / Server Actions) for admin-provisioning,
# service-role storage operations, etc.
# Secret key (sb_secret_…). The legacy name SUPABASE_SERVICE_ROLE_KEY is also accepted.
SUPABASE_SECRET_KEY=

# Base URL of this app, used for building redirect/callback URLs (e.g. password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public website (Al-Asar Degree College). Slug of this institution's row in
# `colleges` — admin-managed website content is read from that college
# (see supabase/migrations/0095_al_asar_public_site_college.sql).
NEXT_PUBLIC_SITE_COLLEGE_SLUG=al-asar-degree-college

# The legacy network-wide public pages (/colleges, /college/<slug>) are
# redirected to the homepage unless this is "true".
ENABLE_MULTI_COLLEGE_SITES=false
